<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/headerRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vortex"
                    android:textColor="@color/vortex_purple"
                    android:textSize="34sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Şarkılar yükleniyor..."
                    android:textColor="@color/vortex_text_secondary"
                    android:textSize="14sp"/>
            </LinearLayout>
        </LinearLayout>

        <EditText
            android:id="@+id/searchBox"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:hint="Şarkı ya da sanatçı ara"
            android:inputType="text"
            android:maxLines="1"
            android:paddingEnd="18dp"
            android:paddingStart="18dp"
            android:singleLine="true"
            android:textColor="@color/vortex_text"
            android:textColorHint="@color/vortex_text_secondary"
            android:textSize="15sp"
            android:visibility="gone"/>

        <ScrollView
            android:id="@+id/pageScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/pageContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </ScrollView>

        <ListView
            android:id="@+id/songList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:listSelector="@android:color/transparent"
            android:scrollbars="none"/>

        <LinearLayout
            android:id="@+id/miniPlayer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <ImageView
                android:id="@+id/miniCover"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="12dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/nowTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="Çalan şarkı yok"
                    android:textColor="@color/vortex_text"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/nowArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="Bir şarkıya dokun"
                    android:textColor="@color/vortex_text_secondary"
                    android:textSize="12sp"/>
            </LinearLayout>

            <ImageView
                android:id="@+id/playPauseButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="10dp"
                android:padding="11dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:paddingBottom="2dp"
            android:paddingTop="2dp">

            <LinearLayout
                android:id="@+id/tabHome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="Ana Sayfa"
                android:focusable="true"
                android:gravity="center"
                android:paddingBottom="6dp"
                android:paddingTop="6dp">

                <ImageView
                    android:id="@+id/iconHome"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="6dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabSearch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="Ara"
                android:focusable="true"
                android:gravity="center"
                android:paddingBottom="6dp"
                android:paddingTop="6dp">

                <ImageView
                    android:id="@+id/iconSearch"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="6dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabLibrary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="Kütüphane"
                android:focusable="true"
                android:gravity="center"
                android:paddingBottom="6dp"
                android:paddingTop="6dp">

                <ImageView
                    android:id="@+id/iconLibrary"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="6dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabDownloads"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="İndirilenler"
                android:focusable="true"
                android:gravity="center"
                android:paddingBottom="6dp"
                android:paddingTop="6dp">

                <ImageView
                    android:id="@+id/iconDownloads"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="6dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nowPlayingScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/npClose"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_gravity="start"
            android:clickable="true"
            android:focusable="true"
            android:padding="11dp"/>

        <ImageView
            android:id="@+id/npArt"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/npTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:ellipsize="end"
            android:gravity="center"
            android:singleLine="true"
            android:text="Çalan şarkı yok"
            android:textColor="@color/vortex_text"
            android:textSize="24sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/npArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:gravity="center"
            android:singleLine="true"
            android:text=""
            android:textColor="@color/vortex_text_secondary"
            android:textSize="15sp"/>

        <SeekBar
            android:id="@+id/npSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/npPosition"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0:00"
                android:textColor="@color/vortex_text_secondary"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/npDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="@color/vortex_text_secondary"
                android:textSize="13sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/npPrev"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:padding="16dp"/>

            <ImageView
                android:id="@+id/npPlayPause"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginEnd="16dp"
                android:layout_marginStart="16dp"
                android:padding="22dp"/>

            <ImageView
                android:id="@+id/npNext"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:padding="16dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/cellLike"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingBottom="4dp"
                android:paddingTop="4dp">

                <ImageView
                    android:id="@+id/npLikeIcon"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="12dp"/>

                <TextView
                    android:id="@+id/npLikeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Beğen"
                    android:textColor="@color/vortex_text_secondary"
                    android:textSize="11sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cellFolder"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingBottom="4dp"
                android:paddingTop="4dp">

                <ImageView
                    android:id="@+id/npFolderIcon"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="12dp"/>

                <TextView
                    android:id="@+id/npFolderLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Klasör"
                    android:textColor="@color/vortex_text_secondary"
                    android:textSize="11sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cellShuffle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingBottom="4dp"
                android:paddingTop="4dp">

                <ImageView
                    android:id="@+id/npShuffleIcon"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="12dp"/>

                <TextView
                    android:id="@+id/npShuffleLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Karıştır"
                    android:textColor="@color/vortex_text_secondary"
                    android:textSize="11sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cellRepeat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingBottom="4dp"
                android:paddingTop="4dp">

                <ImageView
                    android:id="@+id/npRepeatIcon"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="12dp"/>

                <TextView
                    android:id="@+id/npRepeatLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Döngü"
                    android:textColor="@color/vortex_text_secondary"
                    android:textSize="11sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cellSpeed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingBottom="4dp"
                android:paddingTop="4dp">

                <ImageView
                    android:id="@+id/npSpeedIcon"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="12dp"/>

                <TextView
                    android:id="@+id/npSpeedLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="1.0x"
                    android:textColor="@color/vortex_text_secondary"
                    android:textSize="11sp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>